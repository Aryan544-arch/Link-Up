# MEETUP Pulse API Environment Configuration
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/meetup_pulse
CLIENT_ORIGIN=http://localhost:5173

# Authentication & Session (Owned by Person 3)
SESSION_SECRET=replace-with-a-random-secret-at-least-16-chars-long

# Optional Services (Managed by Person 3 in later phases)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# REDIS_URL=
# AI Planning Adapter (Owned by Person 3, optional with deterministic fallback)
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-1.5-flash
