# -------------------------------------------------------------
# MEETUP Pulse — Environment Variables (Example & Baseline)
# Copy this file to .env and configure local values.
# NEVER commit .env to version control.
# -------------------------------------------------------------

# Server Configuration
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Database & Session Store
MONGODB_URI=mongodb://127.0.0.1:27017/meetup_pulse
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional / P1 Features (Leave blank or false for P0 MVP)
ENABLE_AI=false
AI_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@meetuppulse.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
REDIS_URL=
