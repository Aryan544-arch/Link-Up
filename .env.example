# -------------------------------------------------------------
# MEETUP Pulse — Environment Variables (Example & Baseline)
# Copy this file to .env and configure local values.
# NEVER commit .env to version control.
# -------------------------------------------------------------

# Server Configuration
NODE_ENV=development
PORT=
CLIENT_ORIGIN=

# Database & Session Store
MONGODB_URI=
SESSION_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Optional / P1 Features (Leave blank or false for P0 MVP)
ENABLE_AI=
AI_PROVIDER_API_KEY=
AI_MODEL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REDIS_URL=
